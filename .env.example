# Banco de dados (PostgreSQL)
# DB_HOST: use "localhost" ao rodar o backend fora do Docker.
# No docker-compose o host do banco é o nome do serviço ("db"),
# definido diretamente no compose — não depende desta variável.
DB_HOST="localhost"
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="nome_banco"
# DB_PORT: porta em que o Postgres é exposto no host (para acesso externo).
DB_PORT=5432

# Autenticação JWT
# Gere uma chave longa e aleatória, ex.: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET="troque_por_uma_chave_longa_e_aleatoria"

# Backend
PORT=3100

# Frontend (Vite)
VITE_API_URL=http://localhost:3100
