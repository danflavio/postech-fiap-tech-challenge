# Banco de dados (PostgreSQL)
# DB_HOST: use "localhost" ao rodar o backend fora do Docker.
# No docker-compose o host do banco é o nome do serviço ("db"),
# definido diretamente no compose — não depende desta variável.
DB_HOST="localhost"
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="nome_banco"
# DB_PORT: porta em que o Postgres é exposto no host (para acesso externo).
DB_PORT=5432

# Alternativa para bancos gerenciados (Neon, Render, Supabase): connection string única.
# Se definida, tem prioridade sobre DB_HOST/DB_USER/DB_PASSWORD/DB_NAME.
# DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# DB_SSL: força ligar/desligar TLS. Bancos em cloud exigem SSL
# (padrão: ligado quando DATABASE_URL existe).
# DB_SSL=true

# Autenticação JWT
# Gere uma chave longa e aleatória, ex.: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET="troque_por_uma_chave_longa_e_aleatoria"

# Backend
PORT=3100

# Upload de imagens (Cloudinary)
# Obtenha as credenciais em https://console.cloudinary.com (plano gratuito).
CLOUDINARY_CLOUD_NAME="seu_cloud_name"
CLOUDINARY_API_KEY="sua_api_key"
CLOUDINARY_API_SECRET="seu_api_secret"

# Frontend (Vite)
VITE_API_URL=http://localhost:3100

# Origens permitidas no CORS (produção), separadas por vírgula.
# Vazio = libera todas (útil no Docker/dev local).
# Em produção, use o domínio do frontend: CORS_ORIGIN="https://seu-app.vercel.app"
